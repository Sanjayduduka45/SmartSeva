# ==============================================================================
# SMARTSEVA PRODUCTION & DEPLOYMENT ENVIRONMENT VARIABLES
# ==============================================================================

# AI / Gemini API Key (Server-Side Secret - Never exposed to client)
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="your_gemini_api_key_here"

# Application Base URL
# In AI Studio / Cloud Run, automatically injected with the container host URL.
APP_URL="http://localhost:3000"

# Server Network Configuration
PORT=3000
NODE_ENV="production"

# CORS Allowed Origins (Comma-separated list for production)
CORS_ORIGIN="https://smartseva.gov.in,https://smartseva.vercel.app"

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_API=120
RATE_LIMIT_MAX_AI=20

# Supabase / PostgreSQL Configuration (Server-Side Secrets)
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_ANON_KEY="your-anon-public-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-secret-key"

# Client Public Variables (Vite - Exposed to browser)
# VITE_API_URL: Set if frontend is deployed separately (e.g., Vercel) pointing to backend (e.g., Railway)
# If hosted together as a unified full-stack service, leave empty to default to relative /api
VITE_API_URL=""
